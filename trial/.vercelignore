# Vercel only builds the frontend (Vite). Keep the Python backend, logs and
# large local artifacts out of the deployment upload.
scripts/
logs/
# Anchored to the project root so it excludes ./data (local raw artifacts) but
# NOT public/data (static JSON snapshots that must ship to the CDN).
/data/
*.zip
*.log
__pycache__/
.env.development
